---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PostDate from "../components/PostDate.astro";
import Tags from "../components/Tags.astro";
import Categories from "../components/Categories.astro";
import FrontMatter from "../components/FrontMatter.astro";
import Tips from "../components/Tips.astro";
import StructuredData from "../components/StructuredData.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import MarkdownViewToggle from "../components/MarkdownViewToggle.astro";

import PostNavigation from "../components/PostNavigation.astro";
import Comments from "../components/Comments.astro";


type Props = Omit<CollectionEntry<"blog">["data"], "date" | "updated"> & {
  date: Date | string;
  updated?: Date | string;
  description?: string;
  originalId?: string;
  speculationUrls?: string[];
  speculationEagerness?: string;
};

const { 
  title, 
  date, 
  updated, 
  heroImage, 
  tags, 
  categories, 
  description,
  speculationUrls = ["/", "/post", "/categories", "/tags", "/archives"],
  speculationEagerness = "lazy"
} = Astro.props;

// 使用 frontmatter description
const finalDescription = description || '';

// 生成面包屑导航
const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '博客', url: '/post/' },
  { name: title, url: Astro.url.pathname }
];

// 生成结构化数据
const structuredDataProps = {
  title,
  description: finalDescription,
  image: heroImage?.src,
  datePublished: date instanceof Date ? date.toISOString() : new Date(date).toISOString(),
  dateModified: updated ? (updated instanceof Date ? updated.toISOString() : new Date(updated).toISOString()) : (date instanceof Date ? date.toISOString() : new Date(date).toISOString()),
  url: Astro.url.href,
  keywords: tags || [],
  author: {
    name: "Eeymoo",
    url: "https://blog.eeymoo.com"
  },
  publisher: {
    name: "Eeymoo's Blog",
    logo: "https://blog.eeymoo.com/logo.svg"
  },
  articleSection: categories,
  inLanguage: "zh-CN",
  blogUrl: "https://blog.eeymoo.com/",
  blogName: "Eeymoo's Blog"
};

// 检查文章是否有标题（用于判断是否显示 markmap 切换按钮)
const slotContent = await Astro.slots.render('default');
// 过滤掉文章标题 h1，只匹配文章正文中的 h2-h6 标题
const hasHeadings = /<h[2-6][^>]*>/.test(slotContent);
---

<html lang="zh-CN" class="scroll-smooth">
  <head>
    <BaseHead 
      title={title} 
      description={finalDescription} 
      image={heroImage}
      keywords={tags}
      publishedTime={date instanceof Date ? date.toISOString() : new Date(date).toISOString()}
      modifiedTime={updated ? (updated instanceof Date ? updated.toISOString() : new Date(updated).toISOString()) : undefined}
      articleSection={categories}
      speculationUrls={speculationUrls}
      speculationEagerness={speculationEagerness}
    />
    <StructuredData type="BlogPosting" data={structuredDataProps} />
  </head>

  <body class="min-h-screen flex flex-col">
    <Header sticky={false} />
    <main class="flex-1 w-full max-w-285 mx-auto px-4 py-12">
      <!-- 面包屑导航 -->
      <Breadcrumb items={breadcrumbs} />
      
      <article class="bg-slate-50 dark:bg-slate-800/30 rounded-xl p-4">
        <div class="hero-image w-full">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                class="block mx-auto rounded-xl"
              />
            )
          }
        </div>
        <div class="prose w-full max-w-200 mx-auto px-4 text-slate-700 dark:text-slate-300">
          <div class="title mb-4 py-4 text-center leading-tight">
            <h1 class="mb-2 text-2xl sm:text-3xl md:text-4xl font-bold leading-tight">{title}</h1>

            <div class="flex mb-2">
              <PostDate
                date={new Date(date)}
                updated={updated ? new Date(updated) : undefined}
              />
              <Categories categories={categories} link={true} />
            </div>
            <Tags tags={tags} link={true} />
            {
              tags?.includes("AICG") && (
                <div class="mt-3">
                  <Tips type="warning">
                    本文含有 AI 生成的内容，仅供参考，请自行甄别
                  </Tips>
                </div>
              )
            }
          </div>

          <FrontMatter data={Astro.props} />

          <!-- 视图切换按钮 -->
          <MarkdownViewToggle postId={Astro.props.originalId || Astro.url.pathname} hasHeadings={hasHeadings} />

          <!-- 文章内容容器 -->
          <div class="article-content-wrapper">
            <div class="article-content">
              <div class="prose w-full max-w-200 mx-auto">
                <Fragment set:html={slotContent} />
              </div>
            </div>
          </div>
        </div>
      </article>
        
      <!-- 上一篇下一篇导航 -->
      <PostNavigation currentPost={{
        id: Astro.props.originalId || Astro.url.pathname,
        collection: "blog",
        data: Astro.props
      }} />
      
      <!-- 评论区 -->
      <Comments />
    </main>
    <Footer />

    <!-- Markdown 视图切换脚本 -->
    <script>
      import { init } from '../scripts/markmap-view';
      init();
    </script>

    <!-- ZoomImage 客户端脚本 -->
    <script>
      const isPC = () => window.matchMedia('(min-width: 768px) and (hover: hover)').matches;

      if (isPC()) {
        document.querySelectorAll('.zoom-image-wrapper').forEach((wrapper) => {
          const img = wrapper.querySelector('.zoom-image-target') as HTMLImageElement;
          const portal = wrapper.querySelector('.zoom-image-portal') as HTMLElement;
          
          if (!img || !portal) return;
          
          const zoomImg = portal.querySelector('[data-zoom-image]') as HTMLImageElement;
          const isIcon = wrapper.getAttribute('data-is-icon') === 'true';

          if (!zoomImg) return;

          const ZOOM_SIZE = 300;

          img.addEventListener('mouseenter', () => {
            portal.classList.remove('hidden');
            
            if (isIcon) {
              zoomImg.style.width = `${ZOOM_SIZE}px`;
              zoomImg.style.height = `${ZOOM_SIZE}px`;
              zoomImg.style.objectFit = 'contain';
            } else {
              zoomImg.style.maxWidth = `${ZOOM_SIZE}px`;
              zoomImg.style.width = 'auto';
              zoomImg.style.height = 'auto';
              zoomImg.style.objectFit = 'contain';
            }

            if (!isIcon) {
              portal.style.right = '20px';
              portal.style.bottom = '20px';
              portal.style.left = 'auto';
              portal.style.top = 'auto';
            }
          });

          if (isIcon) {
            img.addEventListener('mousemove', (e: MouseEvent) => {
              const offset = 15;
              let x = e.clientX + offset;
              let y = e.clientY + offset;

              if (x + ZOOM_SIZE > window.innerWidth) {
                x = e.clientX - ZOOM_SIZE - offset;
              }

              if (y + ZOOM_SIZE > window.innerHeight) {
                y = e.clientY - ZOOM_SIZE - offset;
              }

              portal.style.left = `${x}px`;
              portal.style.top = `${y}px`;
              portal.style.right = 'auto';
              portal.style.bottom = 'auto';
            });
          }

          img.addEventListener('mouseleave', () => {
            portal.classList.add('hidden');
          });
        });
      } else {
        document.querySelectorAll('.zoom-image-target').forEach((img) => {
          (img as HTMLElement).classList.remove('cursor-pointer');
        });
      }
    </script>
  </body>
</html>
