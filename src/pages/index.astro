        </span>
        <span>Vue</span>
        <span class="zoom-image-wrapper inline-block!" data-is-icon="true">
          <img
            class="zoom-image-target h-4! inline-block!"
            src="https://cdn.simpleicons.org/react?viewbox=auto"
