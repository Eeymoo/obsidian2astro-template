      <div class="flex space-x-2 mb-6">
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/typescript?viewbox=auto"
            alt="TypeScript"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/typescript?viewbox=auto"
              alt="TypeScript"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/javascript?viewbox=auto"
            alt="JavaScript"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/javascript?viewbox=auto"
              alt="JavaScript"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/css?viewbox=auto"
            alt="CSS"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/css?viewbox=auto"
              alt="CSS"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/vue.js?viewbox=auto"
            alt="Vue"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/vue.js?viewbox=auto"
              alt="Vue"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/react?viewbox=auto"
            alt="React"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/react?viewbox=auto"
              alt="React"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/python?viewbox=auto"
            alt="Python"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/python?viewbox=auto"
              alt="Python"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/rss?viewbox=auto"
            alt="RSS"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/rss?viewbox=auto"
              alt="RSS"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/ubuntu?viewbox=auto"
            alt="Ubuntu"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/ubuntu?viewbox=auto"
              alt="Ubuntu"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/debian?viewbox=auto"
            alt="Debian"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/debian?viewbox=auto"
              alt="Debian"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
            />
          </div>
        </span>
        <span class="zoom-image-wrapper" data-is-icon="true">
          <img
            class="zoom-image-target h-6!"
            src="https://cdn.simpleicons.org/rust?viewbox=auto"
            alt="Rust"
            loading="lazy"
          />
          <div class="zoom-image-portal hidden fixed z-50 pointer-events-none">
            <img
              src="https://cdn.simpleicons.org/rust?viewbox=auto"
              alt="Rust"
              class="max-w-none rounded-lg shadow-2xl border border-slate-200 dark:border-slate-700"
              data-zoom-image
