---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { webmcpConnections } from '../../../data/index.ts';
import { extractDescriptionFromContent, filterContent, generatePostSlug } from '../../../utils';

const posts = filterContent(await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8);

const articles = posts.map((post) => {
  const slug = generatePostSlug(post);
  const fullContent = extractDescriptionFromContent(post.body, 8000);
  const previewContent = fullContent.length > 600 ? `${fullContent.slice(0, 600)}...` : fullContent;

  return {
    slug,
    title: post.data.title,
    url: `/post/${slug}.html`,
    date: post.data.date.toISOString(),
    summary: post.data.description || extractDescriptionFromContent(post.body, 180),
    previewContent,
    fullContent,
  };
});

const webmcpPayload = JSON.stringify({
  connections: webmcpConnections,
  articles,
});

const speculationUrls = ['/', '/post', '/tool', '/categories', '/tags', '/archives'];
articles.slice(0, 3).forEach((article) => {
  speculationUrls.push(article.url);
});

function getStatusText(status: string): string {
  if (status === 'connected') return '已连接';
  if (status === 'degraded') return '降级';
  return '断开';
}

function getStatusClass(status: string): string {
  if (status === 'connected') return 'text-green-700 bg-green-100 dark:text-green-300 dark:bg-green-900/40';
  if (status === 'degraded') return 'text-amber-700 bg-amber-100 dark:text-amber-300 dark:bg-amber-900/40';
  return 'text-red-700 bg-red-100 dark:text-red-300 dark:bg-red-900/40';
}
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <BaseHead
      title={`${SITE_TITLE} · WebMCP`}
      description="WebMCP 连接总览与文章内容展示页面"
      speculationUrls={speculationUrls}
      speculationEagerness="moderate"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 py-12 text-base leading-relaxed">
      <section class="mb-12">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
          WebMCP 看板
        </h1>
        <p class="mt-3 text-slate-600 dark:text-slate-400">
          本页支持 WebMCP 运行时读取连接与文章内容，同时提供页面内可视化展示。
        </p>
        <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
          运行时状态：
          <span
            id="webmcp-runtime-status"
            class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"
          >
            初始化中
          </span>
        </p>
        <p id="webmcp-runtime-detail" class="mt-2 text-xs text-slate-500 dark:text-slate-400"></p>
      </section>

      <section class="mb-12">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
            所有连接
          </h2>
          <span class="text-sm text-slate-500 dark:text-slate-400">
            共 {webmcpConnections.length} 条
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {webmcpConnections.map((connection) => (
            <article class="rounded-xl bg-slate-50 dark:bg-slate-800/30 p-4">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-base font-semibold text-slate-900 dark:text-slate-100">
                  {connection.name}
                </h3>
                <span class:list={['px-2 py-0.5 rounded text-xs font-medium', getStatusClass(connection.status)]}>
                  {getStatusText(connection.status)}
                </span>
              </div>
              <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{connection.endpoint}</p>
              <p class="mt-2 text-sm text-slate-700 dark:text-slate-300">{connection.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                {connection.capabilities.map((capability) => (
                  <code class="px-2 py-0.5 rounded bg-primary/10 dark:bg-primary/20 text-primary text-xs">
                    {capability}
                  </code>
                ))}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">
            文章内容展示
          </h2>
          <span class="text-sm text-slate-500 dark:text-slate-400">
            共 {articles.length} 篇
          </span>
        </div>

        {articles.length === 0 ? (
          <p class="text-slate-600 dark:text-slate-400">暂无可展示文章。</p>
        ) : (
          <div class="space-y-4">
            {articles.map((article) => (
              <article class="rounded-xl bg-slate-50 dark:bg-slate-800/30 p-5">
                <div class="flex items-start justify-between gap-4">
                  <a href={article.url} class="no-style">
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100 underline decoration-primary hover:text-primary transition-colors">
                      {article.title}
                    </h3>
                  </a>
                  <time class="text-xs text-slate-500 dark:text-slate-400 shrink-0">{new Date(article.date).toLocaleDateString('zh-CN')}</time>
                </div>
                <p class="mt-3 text-sm text-slate-700 dark:text-slate-300">{article.summary}</p>
                <details class="mt-3 group">
                  <summary class="cursor-pointer text-sm text-primary hover:opacity-80 transition-colors">
                    查看正文预览
                  </summary>
                  <div class="mt-3 rounded-lg bg-white dark:bg-slate-900/60 p-3 text-sm text-slate-700 dark:text-slate-300 whitespace-pre-wrap">
                    {article.previewContent}
                  </div>
                </details>
              </article>
            ))}
          </div>
        )}
      </section>
    </main>
    <Footer />

    <script id="webmcp-page-data" type="application/json" set:html={webmcpPayload}></script>
    <script>
      import { initWebMcp } from '../../../scripts/webmcp';
      void initWebMcp();
    </script>
  </body>
</html>
