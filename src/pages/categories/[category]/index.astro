---
import { type CollectionEntry, getCollection } from "astro:content";
import BaseHead from "../../../components/BaseHead.astro";
import Footer from "../../../components/Footer.astro";
import Header from "../../../components/Header.astro";
import PostDate from "../../../components/PostDate.astro";
import StructuredData from "../../../components/StructuredData.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../../consts";
import { generateCategorySlug, filterContent } from "../../../utils";
import { getPostUrl, getPostAbsUrl } from "../../../utils/urls";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const visible = filterContent(posts);

  const categorySet = new Set<string>();
  for (const post of visible) {
    if (post.data.categories) {
      if (Array.isArray(post.data.categories)) {
        post.data.categories.forEach(cat => categorySet.add(cat));
      } else {
        categorySet.add(post.data.categories);
      }
    }
  }

  return Array.from(categorySet).map((c) => ({
    params: { category: generateCategorySlug(c) },
    props: {},
  }));
}

const rawParam = Astro.params.category ?? "";
const rawSlug = rawParam.replace(/\.html$/, "");

// 找到与当前 slug 对应的原始分类名
const allVisible = filterContent(await getCollection("blog"));
  const categorySet = new Set<string>();
  for (const post of allVisible) {
    if (post.data.categories) {
      if (Array.isArray(post.data.categories)) {
        post.data.categories.forEach(cat => categorySet.add(cat));
      } else {
        categorySet.add(post.data.categories);
      }
    }
  }
const category =
  Array.from(categorySet).find((c) => generateCategorySlug(c) === rawSlug) ??
  rawSlug;

const allPosts = filterContent(await getCollection("blog"))
  .filter((p) => {
    if (!p.data.categories) return false;
    if (Array.isArray(p.data.categories)) {
      return p.data.categories.includes(category);
    } else {
      return p.data.categories === category;
    }
  })
  .sort((a, b) => (b.data.date?.valueOf() || 0) - (a.data.date?.valueOf() || 0));

// 生成面包屑导航
const breadcrumbs = [
  { name: '首页', url: '/' },
  { name: '分类', url: '/categories/' },
  { name: category, url: Astro.url.pathname }
];

// 分类页面结构化数据
const categoryStructuredData = {
  "@type": "CollectionPage",
  name: `${category} - ${SITE_TITLE}`,
  description: `浏览${category}分类下的所有文章`,
  url: Astro.url.href,
  inLanguage: "zh-CN",
  isPartOf: {
    "@type": "WebSite",
    "@id": `${Astro.url.origin}/`,
    name: SITE_TITLE
  },
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: allPosts.length,
    itemListElement: allPosts.map((post, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "BlogPosting",
        name: post.data.title,
        url: getPostAbsUrl(post, Astro.url.origin),
        datePublished: post.data.date.toISOString()
      }
    }))
  }
};
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <BaseHead
      title={`${category} - ${SITE_TITLE}`}
      description={`浏览${category}分类下的所有技术文章，共${allPosts.length}篇文章`}
      keywords={[category, "技术博客", "编程", ...allPosts.flatMap(p => p.data.tags || [])].slice(0, 10)}
    />
    <StructuredData type="WebPage" data={categoryStructuredData} />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 w-full max-w-285 mx-auto px-4 py-12">
      <!-- 面包屑导航 -->
      <Breadcrumb items={breadcrumbs} />
      
      <section>
        <h1 class="m-0 mb-6 text-xl font-bold text-primary dark:text-primary">
          {category}
        </h1>
        {
          allPosts.length === 0 ? (
            <p class="text-gray-600 dark:text-gray-300">该分类暂无文章。</p>
          ) : (
            <ul class="grid grid-cols-1 gap-6 list-none m-0 p-0 sm:grid-cols-2">
              {allPosts.map((post) => {
                return (
                  <li class="w-full first:mb-4">
                    <a
                      href={getPostUrl(post)}
                      class="no-style block bg-slate-50 dark:bg-slate-800/30 hover:bg-primary/20 p-3! sm:p-4! rounded-xl transition-colors"
                    >
                      <h4 class="title m-0 text-gray-900 leading-tight underline decoration-primary hover:decoration-primary transition-colors dark:text-gray-100">
                        {post.data.title}
                      </h4>
                      <PostDate
                        date={post.data.date}
                        updated={post.data.updated}
                      />
                    </a>
                  </li>
                );
              })}
            </ul>
          )
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
