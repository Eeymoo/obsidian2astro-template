---
/**
 * MarkdownViewToggle - 文章视图切换组件
 * 支持两种模式：纯 Markdown、纯 Markmap
 * 移动端只显示 Markdown 视图
 * 构建时判断是否显示：只有文章包含标题时才显示切换按钮
 */

interface Props {
  postId: string;
  hasHeadings?: boolean;
}

const { postId, hasHeadings = false } = Astro.props;
import markmapToggleCssUrl from "../styles/components/markmap-toggle.css?url";
---

{hasHeadings && (<link rel="stylesheet" href={markmapToggleCssUrl} />

<div class="markdown-view-toggle" data-post-id={postId}>
  <div class="toggle-container">
    <button
      type="button"
      class="toggle-btn"
      data-view="md"
      title="Markdown 视图"
      aria-label="切换到 Markdown 视图"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" class="toggle-icon">
        <path d="M593.8 59.1l-547.6 0C20.7 59.1 0 79.8 0 105.2L0 406.7c0 25.5 20.7 46.2 46.2 46.2l547.7 0c25.5 0 46.2-20.7 46.1-46.1l0-301.6c0-25.4-20.7-46.1-46.2-46.1zM338.5 360.6l-61.5 0 0-120-61.5 76.9-61.5-76.9 0 120-61.7 0 0-209.2 61.5 0 61.5 76.9 61.5-76.9 61.5 0 0 209.2 .2 0zm135.3 3.1l-92.3-107.7 61.5 0 0-104.6 61.5 0 0 104.6 61.5 0-92.2 107.7z"/>
      </svg>
    </button>

    <button
      type="button"
      class="toggle-btn"
      data-view="markmap"
      title="思维导图视图"
      aria-label="切换到思维导图视图"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
      <path d="M80 32C53.5 32 32 53.5 32 80s21.5 48 48 48l152 0 0 40-48 48-72 0c-39.8 0-72 32.2-72 72l0 64-8 0c-17.7 0-32 14.3-32 32l0 64c0 17.7 14.3 32 32 32l64 0c17.7 0 32-14.3 32-32l0-64c0-17.7-14.3-32-32-32l-8 0 0-64c0-13.3 10.7-24 24-24l72 0 48 48 0 40-8 0c-17.7 0-32 14.3-32 32l0 64c0 17.7 14.3 32 32 32l64 0c17.7 0 32-14.3 32-32l0-64c0-17.7-14.3-32-32-32l-8 0 0-40 48-48 72 0c13.3 0 24 10.7 24 24l0 64-8 0c-17.7 0-32 14.3-32 32l0 64c0 17.7 14.3 32 32 32l64 0c17.7 0 32-14.3 32-32l0-64c0-17.7-14.3-32-32-32l-8 0 0-64c0-39.8-32.2-72-72-72l-72 0-48-48 0-40 152 0c26.5 0 48-21.5 48-48s-21.5-48-48-48L80 32z"/></svg>
    </button>
  </div>
</div>
)}
