---
import { SITE_TITLE } from "../consts";
import DarkModeButton from "./DarkModeButton.astro";
import ThemeColorButton from "./ThemeColorButton.astro";
import SearchBox from "./SearchBox.astro";
import HeaderLink from "./HeaderLink.astro";
import Logo from "./Logo.astro";
import DotBackground from "./DotBackground.astro";
import config from "../config";


interface Props {
  sticky?: boolean;
}

const { sticky = true } = Astro.props;
const navLinks: any = config.navLinks || [];

// 获取当前路径
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
const pathnameWithoutExt = pathname.replace(/\.html$/, "");

// 检查链接是否激活
const isLinkActive = (link: any): boolean => {
  if (!link.href) return false;
  
  const hrefWithoutExt = String(link.href).replace(/\.html$/, "");
  const subpath = pathnameWithoutExt.match(/[^\/]+/g);
  
  // 完全匹配
  if (hrefWithoutExt === pathnameWithoutExt) return true;
  
  // 子路径匹配
  if (hrefWithoutExt === "/" + (subpath?.[0] || "")) return true;
  
  // 正则匹配
  if (link.activePattern) {
    try {
      const regex = new RegExp(link.activePattern);
      if (regex.test(pathnameWithoutExt)) return true;
    } catch (e) {
      console.error('Invalid activePattern:', link.activePattern, e);
    }
  }
  
  return false;
};
---

<script src="../scripts/header.ts"></script>
<DotBackground />

<header
  class={`bg-white dark:bg-slate-950 px-4 sm:px-6 lg:px-8 py-4 border-b border-slate-100 dark:border-slate-800/60 transition-colors ${sticky ? "sticky top-0 z-50" : ""}`}
>
  <nav
    class="max-w-screen-xl mx-auto flex items-center justify-between gap-4 sm:gap-6 flex-wrap md:flex-nowrap lg:grid lg:grid-cols-[auto_1fr_auto] lg:items-center lg:gap-8"
  >
    <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
      <!-- Mobile Menu Button (Left) -->
      <button
        id="mobile-menu-toggle"
        class="md:hidden flex items-center justify-center w-10 h-10 text-slate-700 dark:text-slate-300 hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors"
        aria-label="Toggle menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 6.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 12.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5ZM12 18.75a.75.75 0 1 1 0-1.5.75.75 0 0 1 0 1.5Z"
          ></path>
        </svg>
      </button>
      
      <!-- 移动端操作按钮切换 (Left) -->
      <button
        id="mobile-actions-toggle"
        class="md:hidden w-10 h-10 flex items-center justify-center text-slate-700 hover:bg-primary/10 transition-colors dark:text-slate-300 dark:hover:bg-primary/20"
        aria-label="更多操作"
        aria-expanded="false"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42"
          ></path>
        </svg>
      </button>

      <!-- Logo (Center on mobile, left on desktop) -->
      <h2 class="no-style text-base m-0 logo">
        <a
          href="/"
          class="no-style underline decoration-primary hover:decoration-primary text-slate-900 dark:text-slate-50 transition-colors flex items-center justify-center md:justify-start"
        >
          <Logo class="inline-block w-6 h-6 mr-2" />
        </a>
      </h2>
    </div>

    <!-- Desktop Navigation -->
    <div
      class="hidden md:flex items-center justify-center gap-4 flex-wrap md:flex-1 md:min-w-0 lg:justify-center"
    >
      <div class="internal-links flex flex-wrap justify-center">
        {
          navLinks && Array.isArray(navLinks) ? navLinks.map((link: any) => (
            <div class="relative group">
              {
                link.children ? (
                  link.href ? (
                    <a href={link.href} class:list={[
                      "no-style nav-link px-2 mx-2 my-2 text-gray-700 dark:text-gray-300 underline hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors rounded",
                      { "font-black decoration-primary! active-link": isLinkActive(link) },
                    ]}>
                      {link.name}
                    </a>
                  ) : (
                    <button class:list={[
                      "no-style nav-link px-2 mx-2 my-2 text-gray-700 dark:text-gray-300 underline hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors rounded",
                      { "font-black decoration-primary! active-link": isLinkActive(link) },
                    ]} disabled={link.disabled}>
                      {link.name}
                    </button>
                  )
                ) : (
                  <HeaderLink href={link.href} activePattern={link.activePattern}>{link.name}</HeaderLink>
                )
              }

              {link.children ? (
                <div class="absolute left-0 mt-2 w-48 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all">
                  <div class="p-2">
                    {Array.isArray(link.children) && link.children.map((child: any) => (
                      <a href={child.href} class="block px-3 py-2 text-sm text-slate-700 dark:text-slate-300 hover:bg-primary/10 rounded">{child.name}</a>
                    ))}
                  </div>
                </div>
              ) : null}
            </div>
          )) : null
        }
      </div>
    </div>

    <!-- Desktop Actions -->
    <div class="flex items-center gap-2 min-w-0 md:justify-end flex-shrink-0">
      <div class="hidden lg:block">
        <SearchBox />
      </div>
      
      <!-- 桌面端操作按钮 -->
      <div class="hidden md:flex items-center gap-2">
        <a
          href="/rss.xml"
          target="_blank"
          class="w-10 h-10 flex items-center justify-center text-slate-700 hover:bg-primary/10 transition-colors dark:text-slate-300 dark:hover:bg-primary/20"
        >
          <span class="sr-only">Subscribe to RSS</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
            ></path>
          </svg>
        </a>
        <DarkModeButton />
        <ThemeColorButton />
      </div>
    </div>
    </div>
  </nav>

  <!-- Mobile Actions Panel (弹出面板) -->
  <div
    id="mobile-actions-panel"
    class="hidden md:hidden absolute left-3 top-full mt-1 bg-white dark:bg-slate-900 rounded-lg shadow-lg border border-slate-200 dark:border-slate-700 p-2 z-50"
  >
    <a
      href="/rss.xml"
      target="_blank"
      class="w-10 h-10 flex items-center justify-center text-slate-700 hover:bg-primary/10 transition-colors dark:text-slate-300 dark:hover:bg-primary/20"
    >
      <span class="sr-only">Subscribe to RSS</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
        ></path>
      </svg>
    </a>
    <DarkModeButton />
    <ThemeColorButton />
  </div>
  
  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden mt-4 pb-4 space-y-2 border-t border-slate-100 dark:border-slate-800/60 pt-4"
  >
    <SearchBox />
    <div class="internal-links flex flex-col gap-2">
      {
        navLinks && Array.isArray(navLinks) ? navLinks.map((link: any) => (
          link.children ? (
            <div>
              {link.href ? (
                <a href={link.href} class="block px-3 py-2 text-slate-900 dark:text-slate-50 font-semibold hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors">{link.name}</a>
              ) : (
                <div class="px-3 py-2 text-slate-900 dark:text-slate-50 font-semibold">{link.name}</div>
              )}
              <div class="pl-4">
                {Array.isArray(link.children) && link.children.map((c: any) => (
                  <a href={c.href} class="block px-3 py-2 text-slate-900 dark:text-slate-50 hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors">{c.name}</a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class="block px-3 py-2 text-slate-900 dark:text-slate-50 hover:bg-primary/10 dark:hover:bg-primary/20 transition-colors"
            >
              {link.name}
            </a>
          )
        )) : null
      }
    </div>
  </div>
</header>
